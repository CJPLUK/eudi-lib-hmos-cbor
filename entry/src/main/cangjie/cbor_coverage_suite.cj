// @consolidated-test (generated by consolidate_tests.py)
/*
 * Coverage top-up: decodeCborAll (multi-item stream decode) and the
 * CborFacadeException path of the tag-24 embedded-CBOR helper.
 */
package ohos_app_cangjie_entry
import ohos_app_cangjie_eudi_cjcbor.cbor.*
import std.collection.ArrayList
import std.unittest.*
import std.unittest.testmacro.*

@Test
public class CborDecodeAllTest {
    // Two CBOR items concatenated in one byte stream are both decoded, in order.
    @TestCase
    func testDecodeAllTwoItems() {
        let first = cborInt(1).encode()
        let second = cborInt(2).encode()
        let stream = ArrayList<UInt8>()
        for (b in first) {
            stream.add(b)
        }
        for (b in second) {
            stream.add(b)
        }
        let items = decodeCborAll(stream.toArray())
        @Assert(items.size, 2)
        match (items[0]) {
            case UInt64Val(n) => @Assert(n, UInt64(1))
            case _ => @Assert(false)
        }
        match (items[1]) {
            case UInt64Val(n) => @Assert(n, UInt64(2))
            case _ => @Assert(false)
        }
    }

    // A single item stream yields exactly one decoded value.
    @TestCase
    func testDecodeAllSingleItem() {
        let items = decodeCborAll(cborInt(1234).encode())
        @Assert(items.size, 1)
    }
}

@Test
public class CborEmbeddedTest {
    // encodeEmbedded wraps in tag 24; decodeEmbedded unwraps back to the original.
    @TestCase
    func testEmbeddedRoundTrip() {
        let original = cborInt(42)
        let wrapped = encodeEmbedded(original)
        let back = decodeEmbedded(wrapped)
        match (back) {
            case UInt64Val(n) => @Assert(n, UInt64(42))
            case _ => @Assert(false)
        }
    }

    // decodeEmbedded on a value that is not a tag-24 wrapper throws
    // CborFacadeException (caught here as evidence of the error path).
    @TestCase
    func testEmbeddedRejectsNonTag24() {
        var threw = false
        try {
            decodeEmbedded(cborInt(7))
        } catch (e: CborFacadeException) {
            threw = true
        }
        @Assert(threw, true)
    }
}
